# Local settings load backend/.env; process environment takes precedence.
# Generate a private local value; never use this marker as a secret.
DJANGO_SECRET_KEY=REPLACE_ME
# Optional local-only flag: accepts exactly true/false (case-insensitive).
DJANGO_DEBUG=false
# Export explicitly when selecting test mode; default remains local.
# DJANGO_SETTINGS_MODULE=config.settings.test



# Required PostgreSQL configuration; provision dedicated local resources first.
# Blank placeholders intentionally fail configuration validation.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_TEST_NAME=
# Test name must start with test_ and differ from DB_NAME.
DB_CONNECT_TIMEOUT=5

# Provider execution is deliberately disabled until a separately approved
# provider/privacy/budget/retention review. Do not add a model, key, timeout,
# or cost limit here: the backend fails closed if any are configured.
LLM_PROVIDER=disabled
