# Reference only: Django currently reads process environment, not this file.
# Generate a private local value; never use this marker as a secret.
DJANGO_SECRET_KEY=REPLACE_ME

# Reserved for later PostgreSQL configuration; unused by the skeleton.
# Values deliberately blank: no database/user/password is provisioned here.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Reserved for separately approved provider/privacy/budget configuration.
# No provider is selected and no LLM request is enabled by these variables.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
