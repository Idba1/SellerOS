# All VITE_* values are public browser configuration, never secrets.
# Required only when the API client is used. During local Vite development,
# use the same-origin URL below: Vite proxies /api requests to Django so the
# browser does not require a permissive backend CORS policy.
# In deployed environments, set this to the approved public API origin ending
# in /api/v1/. VITE_* values are browser-visible and must never be secrets.
VITE_API_BASE_URL=http://127.0.0.1:5173/api/v1/
